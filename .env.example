# .env.example — Copy this file to .env and fill in your values
# SAVE THIS FILE AS: .env.example
# Then copy it:  copy .env.example .env   (Windows)

# ── App Settings ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8050
DEBUG_MODE=True

# ── Data ──────────────────────────────────────────────────────────────────────
# Leave empty to use default: data/weather.csv
DATA_FILE=

